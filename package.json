{
  "name": "elegance-strasbourg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm lint && pnpm typecheck && vitest run && playwright test",
    "db:start": "node scripts/db-local.mjs start",
    "db:stop": "node scripts/db-local.mjs stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "node scripts/db-local.mjs status",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "measure:vitrine": "node scripts/measure-vitrine.mjs",
    "smoke:auth": "node scripts/smoke-supabase-auth.mjs",
    "smoke:db": "vitest run --config vitest.smoke.config.mts",
    "staff:account": "node scripts/staff-account.mjs",
    "manager:set-code": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/manager-code.mjs",
    "manager:set-code:remote": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/manager-code.mjs --remote"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  }
}
