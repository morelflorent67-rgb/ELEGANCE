# Copier vers .env.local (poste de développement) ou .env.production (serveur, droits 600). Jamais commité.
# Aucune de ces valeurs ne doit commencer par NEXT_PUBLIC_ : le navigateur n'a jamais accès à la base (CLAUDE.md, principe 5).

# Postgres : base locale en développement (pnpm db:start), base du serveur en production (127.0.0.1:5432).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Secret qui signe les liens sans connexion (agenda, désinscription) et le code gérant. OBLIGATOIRE.
# Générer : openssl rand -hex 32
APP_SECRET=

# Adresse publique du site, pour les liens des emails et le cookie de session (https => cookie « secure »).
# Par défaut : http://localhost:3000
# SITE_URL=https://elegance-strasbourg.fr

# Référencement : laisser faux jusqu'au lancement du site
ALLOW_INDEXING=false

# Emails (Brevo). Sans clé, aucun email ne part en développement ; en production, ils restent en file.
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Elegance Strasbourg
# EMAIL_TRANSPORT=brevo   # ou « log »

# Secret du cron d'envoi des emails (le minuteur du serveur l'envoie en en-tête Authorization).
# Chaîne aléatoire de 32 caractères ou plus. Générer : openssl rand -hex 32
# CRON_SECRET=

# Encaissement au terminal SumUp Solo (lot 14). Le code marchand et l'identifiant du terminal sont en base (espace gérant,
# « Terminal d'encaissement ») ; seule la clé d'API reste ici. Sans clé, « Encaisser » répond que le terminal n'est pas relié.
# SUMUP_API_KEY=
# SUMUP_AFFILIATE_KEY=
# SUMUP_APP_ID=
# Secret de l'adresse de rappel (par défaut dérivé de APP_SECRET)
# SUMUP_WEBHOOK_SECRET=

# --- Tests uniquement : JAMAIS sur le serveur ---
# Autorise les faux pilotes (AUTH_DRIVER=memory, PAYMENT_DRIVER=fake) : voir src/lib/test-drivers.ts.
# ALLOW_TEST_DRIVERS=true
# AUTH_DRIVER=memory
# PAYMENT_DRIVER=fake
