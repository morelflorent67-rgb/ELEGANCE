# Copier vers .env.local (jamais commité). Aucune de ces valeurs ne doit commencer par NEXT_PUBLIC_ :
# le navigateur n'a jamais accès à la base ni aux clés Supabase (CLAUDE.md, principe 5).

# Postgres (Supabase : chaîne « Transaction pooler » en production, base locale en développement)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (projet de test ou de production : Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Référencement : laisser faux jusqu'au lancement du site
ALLOW_INDEXING=false

# Base distante Supabase, uniquement pour pnpm db:migrate:remote (chaîne « Transaction pooler » avec le mot de passe)
# REMOTE_DATABASE_URL=

# Authentification : « supabase » (défaut). « memory » sert uniquement aux tests de bout en bout et est refusé sur Vercel.
# AUTH_DRIVER=supabase

# Adresse publique du site, pour les liens des emails (par défaut : l'adresse Vercel, puis http://localhost:3000)
# SITE_URL=https://www.exemple.fr

# Secret qui signe les liens sans connexion (agenda). Par défaut : dérivé de SUPABASE_SECRET_KEY.
# APP_SECRET=

# Emails (Brevo). Sans clé, aucun email ne part en développement ; en production, ils restent en file.
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Elegance Strasbourg
# EMAIL_TRANSPORT=brevo   # ou « log »

# Secret du cron d'envoi des emails (Vercel l'envoie en en-tête Authorization). Chaîne aléatoire de 32 caractères ou plus.
# CRON_SECRET=

# Encaissement au terminal SumUp Solo (lot 14). Le code marchand et l'identifiant du terminal sont en base (espace gérant,
# « Terminal d'encaissement ») ; seule la clé d'API reste ici. Sans clé, « Encaisser » répond que le terminal n'est pas relié.
# SUMUP_API_KEY=
# SUMUP_AFFILIATE_KEY=
# SUMUP_APP_ID=
# Secret de l'adresse de rappel (par défaut dérivé de APP_SECRET)
# SUMUP_WEBHOOK_SECRET=
