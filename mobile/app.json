{
  "expo": {
    "name": "Elegance Strasbourg",
    "slug": "elegance-strasbourg",
    "scheme": "elegance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000d1d",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fr.elegancestrasbourg.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Elegance Strasbourg ajoute vos rendez-vous à votre calendrier, seulement quand vous le demandez."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000d1d"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://elegance-strasbourg.fr",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ce3c61cb-c966-49e0-a8b3-3eead73748d6"
      }
    },
    "owner": "fr-services"
  }
}
