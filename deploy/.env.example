# Copié en deploy/.env sur le serveur (droits 600), jamais commité. Les secrets sont générés sur le serveur.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://elegance:<POSTGRES_PASSWORD>@elegance-db:5432/elegance?sslmode=disable
APP_SECRET=
CRON_SECRET=
SITE_URL=https://elegance-strasbourg.fr
ALLOW_INDEXING=false
# Emails (Brevo) et encaissement (SumUp) : à ajouter quand les clés existent (voir ../.env.example).
# JAMAIS ALLOW_TEST_DRIVERS, AUTH_DRIVER ni PAYMENT_DRIVER ici.
# Notifications de l'app iPhone (lot 27) : clé APNs du compte Apple Developer (fichier .p8, retours à la ligne écrits 
). Sans elles, aucune notification ne part.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_SANDBOX=true seulement pour une version de développement (jamais TestFlight ni App Store)
